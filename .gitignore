# ---------------------------------------------------------------------------
# 复现包 .gitignore —— 保护凭证、排除原始数据与运行产物
# ---------------------------------------------------------------------------

# 1) 凭证：绝不提交任何 API key
openfda_key.txt
key.txt
*.key.txt
.env

# 2) 运行缓存 / 日志 / 字节码
__pycache__/
*.pyc
*.log
.pytest_cache/

# 3) 原始数据集（体积过大，且属第三方、有独立许可；由用户按 README §3.3 自行下载）
#    Canada Vigilance 解压后约 2.4 GB，压缩包约 300 MB
cv/extract_extrait.zip
cv/cvponline_extract_20241130/
cv/*.zip
#    ADReCS ADR ontology：第三方公开可下载资源，不随仓库再分发；
#    `_r6_term_dictionary_check.py` 按脚本内 URL 自行下载后生成本仓 CSV
cv/adrecs_ADR_ontology_v3.3.xlsx

# 4) 本地工作目录（含会话记忆、skill 下载暂存、探测脚本）
.workbuddy/
_probe/

# 5) 投稿包（由 _build_submission.py 从 markdown 源重建，属构建产物，不入库）
#    重建：python _build_submission.py && python _verify_docx.py
_upload/

# 6) 编辑器 / 系统 / 临时备份
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
*.bak
*.bak_*
*.orig
*~
*_backup.md

# 7) 稿件重建期的一次性草稿（手稿中间态副本与重建脚本）。
#    正式手稿为 I_正文_IMRaD_en.md；表 S1 由 _gen_table_s1.py 从两个 SOC 结果文件生成，
#    表 S4 由 10_term_dictionary.csv 渲染，两者均由 _check_consistency.py 逐格复核，
#    故这些中间态文件不需要入库。
_head_ms.md
_recover_tail.md
_rebuild_ms.py
_probe_meddra_level.py
_probe_meddra_level.json
_probe_pt_enum.py
_probe_pt_enum.json

# 4) 写作中间稿与临时缓存（不是交付物，不进仓库）
_body_v*.md
_body_new.md
_r6_backup/
_r6_new_chunks.txt
_r6_*cache*.json
_r6_counts.json
_r6_ia.json
_r6_ptdist.json
_r5_editor_out*.txt
_r5_editor_cache.json
